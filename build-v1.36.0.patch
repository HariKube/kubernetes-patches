diff --git a/build/server-image/Dockerfile b/build/server-image/Dockerfile
index 727273082a6..04f5fd7a924 100644
--- a/build/server-image/Dockerfile
+++ b/build/server-image/Dockerfile
@@ -17,8 +17,21 @@
 ARG BASEIMAGE
 ARG BINARY
 
+FROM --platform=linux/$BUILDARCH busybox:latest AS directories
+RUN mkdir -p /tmp/rootfs/var/run/kubernetes /tmp/rootfs/tmp /tmp/rootfs/etc/ssl/certs /tmp/rootfs/etc/ca-certificates /tmp/rootfs/etc/kubernetes/pki /tmp/rootfs/usr/local/share/ca-certificates /tmp/rootfs/usr/share/ca-certificates
+RUN chmod -R 775 /tmp/rootfs/var/run/kubernetes /tmp/rootfs/tmp /tmp/rootfs/etc/ssl/certs /tmp/rootfs/etc/ca-certificates /tmp/rootfs/etc/kubernetes /tmp/rootfs/usr/local/share/ca-certificates /tmp/rootfs/usr/share/ca-certificates
 
 FROM "${BASEIMAGE}"
+LABEL name="HariKube"
+LABEL vendor="inspirNation Bt."
+LABEL version="1.36.0"
+LABEL release="0"
+LABEL summary="Kubernetes HariKube Edition"
+LABEL description="Kubernetes HariKube edition is a horizontally scalable Kubernetes edition."
+LABEL maintainer="richard.kovacs@harikube.com"
+COPY LICENSE /licenses/LICENSE
+COPY --from=directories --chown=65534:0 /tmp/rootfs/* /
+USER 65534
 COPY --chmod=755 ${BINARY} /usr/local/bin/${BINARY}
 # NOTE: /go-runner is used here for compatibility
 COPY --chmod=755 kube-log-runner /go-runner
diff --git a/build/server-image/kube-apiserver/Dockerfile b/build/server-image/kube-apiserver/Dockerfile
index ff815a0afee..7fb67e65373 100644
--- a/build/server-image/kube-apiserver/Dockerfile
+++ b/build/server-image/kube-apiserver/Dockerfile
@@ -25,10 +25,25 @@ COPY --chmod=755 ${BINARY} /binary_to_set
 # non-root and still listen on port less than 1024
 RUN ["setcap", "cap_net_bind_service=+ep", "/binary_to_set"]
 
+FROM --platform=linux/$BUILDARCH busybox:latest AS directories
+RUN mkdir -p /tmp/rootfs/var/run/kubernetes /tmp/rootfs/tmp /tmp/rootfs/etc/ssl/certs /tmp/rootfs/etc/ca-certificates /tmp/rootfs/etc/kubernetes/pki /tmp/rootfs/usr/local/share/ca-certificates /tmp/rootfs/usr/share/ca-certificates
+RUN chmod -R 775 /tmp/rootfs/var/run/kubernetes /tmp/rootfs/tmp /tmp/rootfs/etc/ssl/certs /tmp/rootfs/etc/ca-certificates /tmp/rootfs/etc/kubernetes /tmp/rootfs/usr/local/share/ca-certificates /tmp/rootfs/usr/share/ca-certificates
+
 FROM --platform=linux/$TARGETARCH ${BASEIMAGE}
+LABEL name="HariKube"
+LABEL vendor="inspirNation Bt."
+LABEL version="1.36.0"
+LABEL release="0"
+LABEL summary="Kubernetes HariKube Edition"
+LABEL description="Kubernetes HariKube edition is a horizontally scalable Kubernetes edition."
+LABEL maintainer="richard.kovacs@harikube.com"
+COPY LICENSE /licenses/LICENSE
+COPY --from=directories --chown=65534:0 /tmp/rootfs/* /
+USER 65534
 ARG BINARY
 
 COPY --from=0 /binary_to_set /usr/local/bin/${BINARY}
+COPY --chmod=755 kubectl /usr/local/bin/kubectl
 # NOTE: /go-runner is used here for compatibility
 COPY --chmod=755 kube-log-runner /go-runner
 ENTRYPOINT ["/go-runner"]
